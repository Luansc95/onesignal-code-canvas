                      key={lead.id}
                      onClick={() => setSelectedLead(lead)}
                      className="p-3 rounded-xl bg-[#071B3A] border border-white/10 hover:border-cyan-400/40 text-left transition-all cursor-pointer space-y-2 shadow-md group"
